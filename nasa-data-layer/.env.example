# Copy to .env and paste your key. Get one free at https://api.nasa.gov/ (Generate API Key).
NASA_API_KEY=DEMO_KEY
PORT=3001
# 1 = never call NASA, serve only cached files (for the judges' demo)
OFFLINE=0
# How long a cached upstream response counts as fresh
CACHE_TTL_SECONDS=3600
# Proxy rate limit per client IP per minute
RATE_LIMIT_PER_MIN=30
